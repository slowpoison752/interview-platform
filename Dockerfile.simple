# Multi-stage build for Railway deployment (Simplified version)
FROM node:18-alpine as frontend-build

WORKDIR /app/frontend

# Copy frontend files
COPY frontend/package*.json ./

# Install dependencies
RUN npm install --only=production --legacy-peer-deps

COPY frontend/ ./
RUN npm run build

# Python backend stage
FROM python:3.11-alpine

WORKDIR /app

# Install minimal system dependencies
RUN apk add --no-cache gcc musl-dev curl

# Copy backend requirements and install
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .

# Copy built frontend from previous stage
COPY --from=frontend-build /app/frontend/build /app/static

# Copy static HTML file for health checks
COPY backend/static/index.html /app/static/index.html

# Copy health check script
COPY healthcheck.sh /app/healthcheck.sh
RUN chmod +x /app/healthcheck.sh

# Create startup script
RUN echo '#!/bin/sh\n\
echo "Starting Resume Parser Platform..."\n\
echo "Waiting for application to start..."\n\
uvicorn main:app --host 0.0.0.0 --port 8000 --reload' > /app/start.sh && chmod +x /app/start.sh

EXPOSE 8000

CMD ["/app/start.sh"] 